{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": false,
    "types": ["node"]
  },
  "include": ["src/**/*.js", "src/**/*.d.ts", "tests/**/*.js"],
  "exclude": ["node_modules"]
}
