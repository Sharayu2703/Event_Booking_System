NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/event_booking
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_EXPIRES_IN=1d
REDIS_URL=redis://127.0.0.1:6379
CLIENT_ORIGIN=http://localhost:5173
# Configure a real SMTP account to send real emails. Example: Resend SMTP credentials.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
MAIL_FROM=Event Booking <noreply@example.com>
# Optional: allow one-time bootstrap organizer creation using this secret.
ORGANIZER_INVITE_SECRET=replace_with_long_random_secret
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
